# Force LF line endings in the repository for all text files.
# Prevents CRLF creep from Windows editors on /mnt/d/ filesystems.
* text=auto eol=lf

# Explicit overrides for common types
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.env   text eol=lf

# Binary — never touch line endings
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.db    binary
