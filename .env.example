# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai  # use "openai" or "ollama"
OPENAI_API_KEY=your-openai-api-key-here
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2
OLLAMA_EMBEDDING_MODEL=text2vec

# ── LangSmith (optional — leave blank to disable tracing) ────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=janus-process

# ── Redis (Short-Term Memory) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_ID=brain_session
STM_TTL=3600

# ── ChromaDB (Long-Term Memory) ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Database (Basal Ganglia — Procedural Store) ───────────────────────────────
DATABASE_URL=sqlite:///./habits.db
