# ── LLM provider ────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama              # "ollama" (local, default) | "openai" (cloud)

# ── Ollama  (used when LLM_PROVIDER=ollama) ──────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b          # general fallback for any brain-part override not set
OLLAMA_EMBEDDING_MODEL=nomic-embed-text   # used by Hippocampus

# ── OpenAI  (used when LLM_PROVIDER=openai) ──────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LangSmith (optional — leave blank to disable tracing) ────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=janus-process

# ── Redis (Short-Term Memory) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_ID=brain_session
STM_TTL=7200

# ── Memory Consolidation — timing & windows ──────────────────────────────────
# STM_TTL must always be greater than CONSOLIDATION_INTERVAL_SECONDS
CONSOLIDATION_INTERVAL_SECONDS=1800   # STM→LTM: every 30 min (Tier 1)
LTM_SUMMARIZATION_INTERVAL_SECONDS=86400  # LTM→LTM: daily compression (Tier 2)
CONSOLIDATION_WINDOW=50               # max STM messages read per consolidation pass
LTM_SUMMARIZATION_MIN_DOCS=20         # minimum LTM docs before Tier-2 compression runs

# ── ChromaDB (Long-Term Memory) ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Database (Basal Ganglia — Procedural Store) ───────────────────────────────
DATABASE_URL=sqlite:///./habits.db

# ── LLM Retry ─────────────────────────────────────────────────────────────────
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_MULTIPLIER=0.5
LLM_RETRY_MAX_WAIT=10

# ── Per-brain model overrides ────────────────────────────────────────────────
# Ollama suggestions:  Amygdala/BG → llama3.2:3b (fast)   PFC/Consolidation → qwen2.5:7b (best)
# OpenAI suggestions:  Amygdala/BG → gpt-4o-mini           PFC/Consolidation → gpt-4o

# ── Amygdala ──────────────────────────────────────────────────────────────────
AMYGDALA_MODEL=llama3.2:3b
AMYGDALA_THRESHOLD_LOW=0.2
AMYGDALA_THRESHOLD_MID=0.5
AMYGDALA_THRESHOLD_HIGH=0.7
AMYGDALA_TEMP_NEUTRAL=0.7
AMYGDALA_TEMP_MILD=0.5
AMYGDALA_TEMP_STRESSED=0.3
AMYGDALA_TEMP_CRISIS=0.1

# ── PFC ────────────────────────────────────────────────────────────────────────
PFC_MODEL=qwen2.5:7b
PFC_CONSOLIDATION_THRESHOLD=0.5
PFC_STM_WINDOW=10
PFC_DEFAULT_TEMPERATURE=0.3

# ── Basal Ganglia ─────────────────────────────────────────────────────────────
BG_MODEL=llama3.2:3b

# ── PFC ↔ Basal Ganglia Recurrent Loop ───────────────────────────────────────
MAX_PFC_LOOPS=2                       # max refinement iterations before best-effort reply

# ── Rate Limiting (API server) ────────────────────────────────────────────────
RATE_LIMIT_MAX_CALLS=10               # max requests per window per IP
RATE_LIMIT_WINDOW_SECONDS=60          # sliding window duration (seconds)

# ── Hippocampus ────────────────────────────────────────────────────────────────
HIPPOCAMPUS_THRESHOLD=0.5
HIPPOCAMPUS_K=5
HIPPOCAMPUS_SEARCH_TYPE=mmr
HIPPOCAMPUS_COLLECTION=episodic

# ── Memory Consolidation (extended) ───────────────────────────────────────────
CONSOLIDATION_COLLECTION=episodic
CONSOLIDATION_LLM_TEMPERATURE=0.3
CONSOLIDATION_MODEL=qwen2.5:7b

# ── System Prompts ──────────────────────────────────────────────────────────────
# Use \n for newlines. Edit here to customise each agent's behaviour.
AMYGDALA_SYSTEM_PROMPT=You are an emotional salience classifier.\nRate how emotionally charged or urgent the following input is on a scale from 0.0 to 1.0.\n\nCalibration guide:\n  0.0 — completely neutral (e.g., \"What is 2 + 2?\", \"Set a reminder\")\n  0.3 — mildly personal or moderately important\n  0.6 — clearly emotional or stressful\n  1.0 — crisis-level or highly distressing (grief, fear, rage, emergency)\n\nReply with ONLY a single decimal number between 0.0 and 1.0. Nothing else.
BG_SYSTEM_PROMPT=You are a habit pattern classifier.\n\nYou will be given a list of known habit patterns (each with an ID and a description) and a user input.  Decide whether the user input has the same intent as any listed habit pattern.\n\nReply with ONLY the integer ID of the matching habit.\nIf no habit matches, reply with ONLY the word NONE.\nDo not explain your answer.
BG_GATE_SYSTEM_PROMPT=You are a response quality evaluator for a brain-inspired AI system.\n\nYou will receive the user's original input and a proposed response.\nEvaluate whether the response is appropriate, helpful, accurate, and relevant.\n\nIf the response is acceptable, reply with exactly:\n  ACCEPT\n\nIf the response needs improvement, reply with:\n  REFINE: <concise, specific instruction on exactly what to fix>\n\nDo not explain your reasoning beyond the instruction.
PFC_SYSTEM_PROMPT=You are the Prefrontal Cortex (PFC) — the core reasoning and synthesis centre of a brain-inspired AI system.\n\nYou receive:\n  • The user's current input\n  • Working memory: the most recent conversation turns (short-term memory)\n  • Retrieved memories: relevant long-term memories retrieved from a vector store\n  • Procedural match: a pre-learned habitual response if one was found (may be absent)\n\nYour task: synthesise all of the above into a single, coherent, helpful response to the user's input. Use working memory for conversational continuity, retrieved memories for relevant background knowledge, and the procedural match (if present) as a strong starting signal.\n\nBe concise and direct. Do not mention that you are an AI or reference these internal memory systems in your response.
