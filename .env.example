# ── LLM provider ────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama              # "ollama" (local, default) | "openai" (cloud)

# ── Ollama  (used when LLM_PROVIDER=ollama) ──────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b          # general fallback for any brain-part override not set
OLLAMA_EMBEDDING_MODEL=nomic-embed-text   # used by Hippocampus

# ── OpenAI  (used when LLM_PROVIDER=openai) ──────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LangSmith (optional — leave blank to disable tracing) ────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=janus-process

# ── Redis (Short-Term Memory) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_ID=brain_session
STM_TTL=7200

# ── Memory Consolidation — timing & windows ──────────────────────────────────
# STM_TTL must always be greater than CONSOLIDATION_INTERVAL_SECONDS
CONSOLIDATION_INTERVAL_SECONDS=1800   # STM→LTM: every 30 min (Tier 1)
LTM_SUMMARIZATION_INTERVAL_SECONDS=86400  # LTM→LTM: daily compression (Tier 2)
CONSOLIDATION_WINDOW=50               # max STM messages read per consolidation pass
LTM_SUMMARIZATION_MIN_DOCS=20         # minimum LTM docs before Tier-2 compression runs

# ── ChromaDB (Long-Term Memory) ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Database (Basal Ganglia — Procedural Store) ───────────────────────────────
DATABASE_URL=sqlite:///./habits.db

# ── LLM Retry ─────────────────────────────────────────────────────────────────
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_MULTIPLIER=0.5
LLM_RETRY_MAX_WAIT=10

# ── Per-brain model overrides ────────────────────────────────────────────────
# Ollama suggestions:  Amygdala/BG → llama3.2:3b (fast)   PFC/Consolidation → qwen2.5:7b (best)
# OpenAI suggestions:  Amygdala/BG → gpt-4o-mini           PFC/Consolidation → gpt-4o

# ── Amygdala ──────────────────────────────────────────────────────────────────
AMYGDALA_MODEL=llama3.2:3b
AMYGDALA_THRESHOLD_LOW=0.2
AMYGDALA_THRESHOLD_MID=0.5
AMYGDALA_THRESHOLD_HIGH=0.7
AMYGDALA_TEMP_NEUTRAL=0.7
AMYGDALA_TEMP_MILD=0.5
AMYGDALA_TEMP_STRESSED=0.3
AMYGDALA_TEMP_CRISIS=0.1

# ── PFC ────────────────────────────────────────────────────────────────────────
PFC_MODEL=qwen2.5:7b
PFC_CONSOLIDATION_THRESHOLD=0.5
PFC_STM_WINDOW=10
PFC_DEFAULT_TEMPERATURE=0.3

# ── Basal Ganglia ─────────────────────────────────────────────────────────────
BG_MODEL=llama3.2:3b

# ── PFC ↔ Basal Ganglia Recurrent Loop ───────────────────────────────────────
MAX_PFC_LOOPS=2                       # max refinement iterations before best-effort reply

# ── Rate Limiting (API server) ────────────────────────────────────────────────
RATE_LIMIT_MAX_CALLS=10               # max requests per window per IP
RATE_LIMIT_WINDOW_SECONDS=60          # sliding window duration (seconds)

# ── Hippocampus ────────────────────────────────────────────────────────────────
HIPPOCAMPUS_THRESHOLD=0.5
HIPPOCAMPUS_K=5
HIPPOCAMPUS_SEARCH_TYPE=mmr
HIPPOCAMPUS_COLLECTION=episodic

# ── Memory Consolidation (extended) ───────────────────────────────────────────
CONSOLIDATION_COLLECTION=episodic
CONSOLIDATION_LLM_TEMPERATURE=0.3
CONSOLIDATION_MODEL=qwen2.5:7b

# ── System Prompts ────────────────────────────────────────────────────────────────────────────────
# Single-line values, single-quoted. Edit to customise each agent behaviour.
AMYGDALA_SYSTEM_PROMPT='You are an emotional salience classifier. Rate the emotional urgency of the input from 0.0 (completely neutral) to 1.0 (crisis level). Reply with ONLY a single decimal number.'
BG_SYSTEM_PROMPT='You are a habit pattern classifier. Match the user input to a known habit ID or reply NONE. No explanation.'
BG_GATE_SYSTEM_PROMPT='Evaluate whether the proposed response is appropriate and helpful. Reply ACCEPT if good, or REFINE: <specific fix instruction> if it needs improvement.'
PFC_SYSTEM_PROMPT='You are the reasoning core prefrontal cortex of the brain. Synthesise the user input, working memory, retrieved memories and any procedural match into one clear helpful response. Be concise and direct.'
